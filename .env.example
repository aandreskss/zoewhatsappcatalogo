# ─────────────────────────────────────────────────────────────────────────
# Variables PÚBLICAS (van al bundle del navegador — nunca poner secretos aquí)
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Se completan en la Fase 9 (Analítica e integraciones). Dejarlas vacías
# hasta entonces es seguro: el código debe tolerar que no existan.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─────────────────────────────────────────────────────────────────────────
# Variables de SERVIDOR (secretos — nunca exponer al cliente, nunca commitear
# el archivo .env real con valores reales)
# ─────────────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Autentica los jobs programados (liberar reservas de stock, refrescar tasa
# BCV, reportes nocturnos) para que nadie más pueda invocarlos por HTTP.
CRON_SECRET=

# Se completan cuando se implementen las integraciones correspondientes
# (Fase 9 analítica, Fase 6 tasa BCV). No son necesarias para la Fase 0.
META_CAPI_ACCESS_TOKEN=
META_CAPI_DATASET_ID=
GOOGLE_ADS_CONVERSION_SECRET=
EXCHANGE_RATE_PROVIDER_API_KEY=
